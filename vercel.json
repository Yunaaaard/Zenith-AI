{
  "rewrites": [
    {
      "source": "/api/ai/:path*",
      "destination": "https://tabitoken.com/v1/:path*"
    },
    {
      "source": "/api/ar/:path*",
      "destination": "https://agentrouter.org/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
